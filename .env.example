# DeepSeek (OpenAI compatible)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Remote DB / Redis (192.168.0.121)
# Agent 自己的表放独立库 db_agent，不要复用业务库 db_*
# 初始化：createdb db_agent && psql "$AGENT_PG_DSN" -f scripts/db/agent_schema.sql
# AGENT_PG_DSN=postgresql://<user>:<password>@192.168.0.121:5432/db_agent
# 无 DSN 时审批单/挂起任务自动回落 InMemory
# AGENT_PG_OFFLINE=1
# AGENT_POOL_SIZE=3

# 真实 Postgres 集成测试（应用不读取；仅 pytest 使用）
# AGENT_TEST_PG_DSN=postgresql://<user>:<password>@192.168.0.121:5432/db_agent

# 记忆/五层 store（旧配置保留）
# POSTGRES_DSN=postgresql://<user>:<password>@192.168.0.121:5432/postgres
# REDIS_URL=redis://192.168.0.121:6379/0
# PG_DSN 与 POSTGRES_DSN 同义；仅旧版 MemoryStore 使用，不会开启 Agent 持久化
# Agent 持久化唯一开关是 AGENT_PG_DSN

# RAG（默认本地确定性 embedding；pgvector 默认关闭）
# RAG_EMBEDDING_PROVIDER=hashing
# RAG_PGVECTOR_ENABLED=1
# RAG_PGVECTOR_DSN=postgresql://<user>:<password>@192.168.0.121:5432/db_agent

# Context assembly budget (tokens; assembler enforces usage <= total)
# CONTEXT_BUDGET_TOKENS=8000
# CONTEXT_RESERVED_TOKENS=1000

# Context compression (spec#2: assembler triggers provider.compress when usage > ratio*available)
# CONTEXT_COMPRESS_RATIO=0.8
# CONVERSATION_KEEP_RECENT=3
# OBSERVATION_KEEP_RECENT=5

# Memory PG (spec#3: connector factory honors PG_OFFLINE; schema idempotent)
# PG_OFFLINE=0
# MEMORY_POOL_SIZE=5
# MEMORY_QUERY_LIMIT=10

# Model pricing per 1k tokens (spec#4: AgentTask cost accumulator)
# MODEL_PRICING_INPUT=0.001
# MODEL_PRICING_OUTPUT=0.002

# AgentTask status history cap (spec#4: AgentTask.history ring buffer)
# AGENT_STATUS_HISTORY=50

AGENT_PORT=8762
SCM_GATEWAY_URL=http://localhost:8761
SCM_AUTH_URL=http://localhost:8106
SCM_USERNAME=
SCM_PASSWORD=
SCM_TENANT_MAP={"t1":"tenant_001"}
SCM_TIMEOUT_SECONDS=5
# Phase 1 #3: 重试退避秒数（5xx/ConnectError 重试 1 次前 sleep）
SCM_RETRY_BACKOFF_SECONDS=0.3
